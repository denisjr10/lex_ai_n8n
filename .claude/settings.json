{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/estado-do-repo.mjs",
            "timeout": 15,
            "statusMessage": "Lendo o estado do repositório..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/guarda-escavador.mjs",
            "timeout": 10,
            "statusMessage": "Conferindo o orçamento do Escavador..."
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/guarda-segredo.mjs",
            "timeout": 20,
            "statusMessage": "Conferindo segredo e dado de cliente..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/anotar-escrita.mjs",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/fechar-ciclo.mjs",
            "timeout": 15,
            "statusMessage": "Conferindo se o ciclo foi fechado..."
          }
        ]
      }
    ]
  }
}
