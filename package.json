{
  "name": "lex-ai-n8n",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma de automacao e agentes de IA para escritorio de advocacia — monorepo",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "mcp-servers/*",
    "services/*"
  ],
  "scripts": {
    "banco:subir": "node ferramentas/banco/subir.mjs",
    "banco:migrar": "node ferramentas/banco/migrar.mjs",
    "banco:estado": "node ferramentas/banco/migrar.mjs --estado",
    "banco:conferir": "node ferramentas/banco/conferir-regras.mjs",
    "banco:auditoria": "node ferramentas/banco/conferir-auditoria.mjs",
    "receptor:conferir": "node ferramentas/receptor/recolher-do-n8n.mjs --conferir",
    "receptor:recolher": "node ferramentas/receptor/recolher-do-n8n.mjs --gravar",
    "banco:derrubar": "node ferramentas/banco/subir.mjs --derrubar",
    "banco:zerar": "node ferramentas/banco/subir.mjs --zerar",
    "verificar": "node ferramentas/banco/migrar.mjs --conferir && node ferramentas/banco/conferir-regras.mjs && node ferramentas/banco/conferir-auditoria.mjs && npm run testes",
    "tipos": "tsc --build",
    "testes": "npm run tipos && node --test \"testes/**/*.test.mjs\"",
    "limpar": "tsc --build --clean",
    "test": "npm run testes"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "typescript": "^5.6.0"
  }
}
